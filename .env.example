# Environment
ENVIRONMENT=development

# API
API_URL=http://localhost:8787

# AI Providers
OPENAI_API_KEY=sk-your-openai-key-here
AI_PROVIDER=openai

# Cloudflare (for remote development / deployment)
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

# D1 (set via wrangler - local dev uses .wrangler/state)
# DATABASE_ID=your-d1-database-id

# R2 (set via wrangler bindings)
# R2_BUCKET_NAME=social-autopilot-media
