# Environment
ENVIRONMENT=development

# API
API_URL=http://localhost:8787

# AI Providers
OPENAI_API_KEY=sk-your-openai-key-here
AI_PROVIDER=openai

# Cloudflare (for remote development / deployment)
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

# D1 (set via wrangler - local dev uses .wrangler/state)
# DATABASE_ID=your-d1-database-id

# Shopee Affiliate Open API (Worker secrets — never commit values)
# Get App ID / Secret from https://affiliate.shopee.vn/open_api/list after API access is granted.
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=
# SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.vn/graphql
