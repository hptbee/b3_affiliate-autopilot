{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "social-autopilot-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-autopilot-db",
      "database_id": "local-dev-database-id",
      "migrations_dir": "../../packages/database/src/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "social-autopilot-publish"
      }
    ]
  },
  "env": {
    "staging": {
      "name": "social-autopilot-scheduler-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "social-autopilot-db-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "../../packages/database/src/migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "PUBLISH_QUEUE",
            "queue": "social-autopilot-publish-staging"
          }
        ]
      }
    },
    "production": {
      "name": "social-autopilot-scheduler",
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "social-autopilot-db",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "../../packages/database/src/migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "PUBLISH_QUEUE",
            "queue": "social-autopilot-publish"
          }
        ]
      }
    }
  }
}
