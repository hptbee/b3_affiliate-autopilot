{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "social-autopilot-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 2 * * *", "0 */6 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "AI_PROVIDER": "workers-ai",
    "CORS_ORIGIN": "http://localhost:5173",
    "AFFILIATE_PIPELINE_CRON": "0 2 * * *",
    "AFFILIATE_PIPELINE_ENABLED": "true",
    "AFFILIATE_PIPELINE_INTERVAL_HOURS": "24",
    "AFFILIATE_PIPELINE_LIMIT": "5",
    "POST_ANALYTICS_CRON": "0 */6 * * *",
    "POST_ANALYTICS_ENABLED": "true",
    "POST_ANALYTICS_INTERVAL_HOURS": "6",
    "POST_ANALYTICS_BATCH_LIMIT": "50"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-autopilot-db",
      "database_id": "local-dev-database-id",
      "migrations_dir": "../../packages/database/src/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "social-autopilot-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "social-autopilot-publish"
      }
    ],
    "consumers": [
      {
        "queue": "social-autopilot-publish",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "social-autopilot-publish-dlq"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "env": {
    "staging": {
      "name": "social-autopilot-api-staging",
      "triggers": {
        "crons": ["*/5 * * * *", "0 2 * * *", "0 */6 * * *"]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "AI_PROVIDER": "workers-ai",
        "CORS_ORIGIN": "https://staging.example.com",
        "AFFILIATE_PIPELINE_CRON": "0 2 * * *",
        "AFFILIATE_PIPELINE_ENABLED": "true",
        "AFFILIATE_PIPELINE_INTERVAL_HOURS": "24",
        "AFFILIATE_PIPELINE_LIMIT": "5",
    "POST_ANALYTICS_CRON": "0 */6 * * *",
    "POST_ANALYTICS_ENABLED": "true",
    "POST_ANALYTICS_INTERVAL_HOURS": "6",
    "POST_ANALYTICS_BATCH_LIMIT": "50"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "social-autopilot-db-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "../../packages/database/src/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "social-autopilot-media-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "PUBLISH_QUEUE",
            "queue": "social-autopilot-publish-staging"
          }
        ],
        "consumers": [
          {
            "queue": "social-autopilot-publish-staging",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "social-autopilot-publish-dlq-staging"
          }
        ]
      }
    },
    "production": {
      "name": "social-autopilot-api",
      "triggers": {
        "crons": ["*/5 * * * *", "0 2 * * *", "0 */6 * * *"]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "AI_PROVIDER": "openai",
        "CORS_ORIGIN": "https://app.example.com",
        "AFFILIATE_PIPELINE_CRON": "0 2 * * *",
        "AFFILIATE_PIPELINE_ENABLED": "true",
        "AFFILIATE_PIPELINE_INTERVAL_HOURS": "24",
        "AFFILIATE_PIPELINE_LIMIT": "5",
    "POST_ANALYTICS_CRON": "0 */6 * * *",
    "POST_ANALYTICS_ENABLED": "true",
    "POST_ANALYTICS_INTERVAL_HOURS": "6",
    "POST_ANALYTICS_BATCH_LIMIT": "50"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "social-autopilot-db",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "../../packages/database/src/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "social-autopilot-media"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "PUBLISH_QUEUE",
            "queue": "social-autopilot-publish"
          }
        ],
        "consumers": [
          {
            "queue": "social-autopilot-publish",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "social-autopilot-publish-dlq"
          }
        ]
      }
    }
  }
}
