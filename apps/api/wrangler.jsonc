{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "social-autopilot-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "development",
    "AI_PROVIDER": "workers-ai",
    "CORS_ORIGIN": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-autopilot-db",
      "database_id": "local-dev-database-id",
      "migrations_dir": "../../packages/database/src/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "social-autopilot-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "social-autopilot-publish"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "env": {
    "staging": {
      "name": "social-autopilot-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "AI_PROVIDER": "workers-ai"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "social-autopilot-db-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "../../packages/database/src/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "social-autopilot-media-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "PUBLISH_QUEUE",
            "queue": "social-autopilot-publish-staging"
          }
        ]
      }
    },
    "production": {
      "name": "social-autopilot-api",
      "vars": {
        "ENVIRONMENT": "production",
        "AI_PROVIDER": "openai"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "social-autopilot-db",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "../../packages/database/src/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "social-autopilot-media"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "PUBLISH_QUEUE",
            "queue": "social-autopilot-publish"
          }
        ]
      }
    }
  }
}
